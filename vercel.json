{
  "version": 2,
  "buildCommand": "npm install && cd apps/web && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "react",
  "env": {
    "REACT_APP_API_URL": "@api_url"
  },
  "envVars": {
    "api_url": "https://api-url-here"
  },
  "rewrites": [
    {
      "source": "/:path((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
