{
  "version": 2,
  "buildCommand": "cd apps/web && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://api-url-here"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Color-Scheme",
          "value": "dark"
        }
      ]
    }
  ]
}
