{
  "version": 2,
  "buildCommand": "npm install && cd apps/web && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "react",
  "rewrites": [
    {
      "source": "/:path((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
