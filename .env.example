# CRITICAL: This file is a template. DO NOT commit the actual .env file to the repository.
# Create a .env file in your environment and populate it with real values.
# NEVER commit secrets to version control.

# Database
DATABASE_URL=postgresql://user:password@host/dbname

# Security
# Generate a secure string (e.g., `openssl rand -hex 32`)
JWT_SECRET=your-jwt-secret-here

# Environment
NODE_ENV=production
API_PORT=3000
LOG_LEVEL=info

# Frontend Config
REACT_APP_API_URL=https://api-url-here
